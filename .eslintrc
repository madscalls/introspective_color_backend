{
  "env": {
    "node": true,
    "es2021": true,
  },
  "extends": ["airbnb-base", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "linebreak-style": "off",
    "no-console": "off",
    "consistent-return": "off",
    "class-methods-use-this": "off",
  },
}
